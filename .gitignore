.env
.env.*
!.env.example
__pycache__/
*.pyc
.venv/
node_modules/
dist/
*.log
# Skill "taste" cài local cho agent — không thuộc app
.agents/
skills-lock.json
# Cache pytest/e2e
test/**/__pycache__/
.pytest_cache/

# Runtime uploads (file người dùng tải lên)
backend/uploads/

# Tài liệu kỹ thuật — artifact sinh ra (giữ .md + script build)
doc/tai-lieu-ky-thuat/export/mermaid.min.js
doc/tai-lieu-ky-thuat/export/*.pdf
doc/tai-lieu-ky-thuat/export/*.png
doc/tai-lieu-ky-thuat/export/*.html

# Celery beat schedule (dev)
backend/celerybeat-schedule*
celerybeat-schedule*

# Tinh chỉnh Docker RIÊNG của từng máy. `docker compose up` tự gộp tệp này đè lên
# docker-compose.yml mà không cần cờ -f, nên nó là chỗ để hạ/nâng trần tài nguyên cho
# hợp với máy mình mà không đụng vào cấu hình dùng chung của cả đội.
# Trần dùng chung nằm ngay trong docker-compose.yml; cách dùng ở
# doc/tai-lieu-ky-thuat/gioi-han-tai-nguyen-docker.md
docker-compose.override.yml

# Bản xuất dữ liệu để đồng bộ môi trường — sinh bằng
# `scripts/export-van-thu-phe-duyet.sh`. KHÔNG đẩy lên git: tệp chứa dữ liệu
# thật của một môi trường cụ thể, và nó cũ đi ngay khi ai đó sửa dữ liệu.
# Bản dump dữ liệu thật vẫn bỏ qua; riêng gói tài khoản test idempotent cần đưa
# theo source để có thể nạp đồng nhất lên môi trường DEV/UAT.
db-export/*
!db-export/test-accounts-van-thu-phap-nhan-20260821.sql

# Ảnh chụp màn hình + kịch bản chạy tay của skill chrome-devtools. Rác của một
# máy cụ thể: sinh ra lúc kiểm bằng trình duyệt thật rồi bỏ. Kịch bản nào đáng
# giữ lâu dài thì chuyển vào `test/e2e/` chứ không để ở đây.
.claude/chrome-devtools/

# Tệp tạm Vite sinh ra cạnh vite.config.ts khi nạp config (frontend/, frontend-v2/,
# help-center/). Bình thường Vite tự xóa sau khi nạp xong; còn sót lại là do lần chạy
# trước bị ngắt giữa chừng — đã lỡ commit một lần trong e7dbd99.
*.timestamp-*.mjs
