# ERP v2 — bản giao diện dựng lại (React 19 + Vite 8 + Tailwind 4), dev server + HMR.
# Node 22 chứ không phải 20 như hai app kia: Vite 8 và TypeScript 7 đòi Node >= 20.19,
# và @types/node ở đây là bản 26.
FROM node:22-alpine

WORKDIR /app

# npm ci theo lockfile chứ không npm install: npm 10.9.8 trong image này dính bug
# arborist "Cannot read properties of null (reading 'edgesOut')" khi tự giải cây mới
# từ registry (04/09/2026) — đi theo package-lock.json thì né được, lại build ổn định.
COPY frontend-v2/package.json frontend-v2/package-lock.json /app/
RUN npm ci

COPY frontend-v2/ /app/

EXPOSE 5174
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
