# ERP v2 — bản giao diện dựng lại (React 19 + Vite 8 + Tailwind 4), dev server + HMR.
# Node 22 chứ không phải 20 như hai app kia: Vite 8 và TypeScript 7 đòi Node >= 20.19,
# và @types/node ở đây là bản 26.
FROM node:22-alpine

WORKDIR /app

# bao-CR-385: cài theo package-lock.json (npm ci) thay vì npm install thả nổi —
# npm install phân giải lại phiên bản mỗi lần build, một gói phụ thuộc vừa phát hành
# bản lỗi là arborist của npm sập ("Cannot read properties of null (reading 'edgesOut')").
COPY frontend-v2/package.json frontend-v2/package-lock.json /app/
RUN npm ci --no-audit --no-fund

COPY frontend-v2/ /app/

EXPOSE 5174
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
