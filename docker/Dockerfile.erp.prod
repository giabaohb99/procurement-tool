# ERP v2 (frontend-v2/) bản triển khai — build tĩnh bằng Vite rồi phục vụ + proxy /api bằng nginx.
# Khác `Dockerfile.erp` (bản dev): bản kia chạy `npm run dev` có HMR và bind-mount code,
# bản này đóng gói sẵn thư mục dist nên không cần Node lúc chạy.
#
# Node 22 chứ không phải 20 như hai app kia: Vite 8 đòi Node >= 20.19 và @types/node ở đây là bản 26.
FROM node:22-alpine AS build
WORKDIR /app
# `npm ci` chứ không phải `npm install`: cài đúng bản ghi trong package-lock.json, nhất là
# typescript phải là 5.9.3 (D-027) — typescript-eslint 8 chưa chạy được trên TypeScript 7.
COPY frontend-v2/package.json frontend-v2/package-lock.json /app/
RUN npm ci
COPY frontend-v2/ /app/
# Gọi API bằng đường TƯƠNG ĐỐI (VITE_API_URL rỗng) rồi để nginx trong container này proxy
# /api -> api:8000. Cùng origin nên không dính CORS và không phải khai domain lúc build.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_APP_NAME=""
ENV VITE_APP_NAME=$VITE_APP_NAME
# Trung tâm Hướng dẫn sử dụng là app riêng (subdomain riêng) — menu HDSD link ra đây.
ARG VITE_HELP_URL=""
ENV VITE_HELP_URL=$VITE_HELP_URL
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.erp.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
