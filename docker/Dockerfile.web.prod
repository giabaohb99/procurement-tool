# Frontend production — build static (Vite) rồi phục vụ + proxy /api bằng nginx
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json /app/package.json
RUN npm install
COPY frontend/ /app/
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_DEVELOPER_MODE=""
ENV VITE_DEVELOPER_MODE=$VITE_DEVELOPER_MODE
ARG VITE_PWA_INSTALL_PROMPT=""
ENV VITE_PWA_INSTALL_PROMPT=$VITE_PWA_INSTALL_PROMPT
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
