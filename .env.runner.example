# .env.runner — MÁY SỬA MÃ tách rời (ai-CR-055). Chép thành `.env.runner`, điền, KHÔNG commit.
# Máy này không có bot, không có token Telegram, không có khóa Gemini. Chỉ có khóa của CHỦ MÁY.
# Hướng dẫn từng bước: doc/agent-hub/05-may-sua-ma.md

# ── Máy này là ai (đại ca cấp bằng câu nhắn «thêm máy của anh Được», bot trả hai dòng này) ──
AGENT_RUNNER_NAME=
AGENT_RUNNER_TOKEN=

# ── Đường hầm SSH lên server dev (container `tunnel`) ──
AGENT_TUNNEL_HOST=
AGENT_TUNNEL_PORT=22
AGENT_TUNNEL_USER=
# Khóa SSH RIÊNG của máy này (ssh-keygen -t ed25519 -f ~/.ssh/agent_tunnel_<tên máy>); phần công khai
# đưa đại ca thêm vào authorized_keys trên VPS với giới hạn chỉ mở cổng.
AGENT_TUNNEL_SSH_KEY_FILE=
# Cổng chuyển tiếp trên VPS (socat db-forward / redis-dev-forward, chỉ nghe 127.0.0.1).
AGENT_TUNNEL_DB_PORT=13306
AGENT_TUNNEL_REDIS_PORT=16379

# ── DB + Redis dev qua đường hầm (đừng đổi host/port: 127.0.0.1 là đầu đường hầm trong container) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
# Tài khoản MySQL RIÊNG cho máy sửa mã, chỉ đụng các bảng tab_agent_* (đại ca tạo theo doc 05).
DB_USER=agent_runner
DB_PASSWORD=
# Ngăn Redis của bot trên dev (số ngăn phải trùng với stack bot dev).
REDIS_URL=redis://127.0.0.1:6379/0
# Khóa Fernet của dev (JWT_SECRET trong .env.dev): máy giải mã khóa Gemini cá nhân của đại ca khi lập lại kế
# hoạch sau rà soát. Chỉ máy đại ca cần; máy khác để trống.
JWT_SECRET=

# ── Bot ──
AGENT_HUB_ENABLED=true
# Chat đại ca (cùng số như trên dev): tin báo lỗi từ máy này gửi vòng qua worker của bot về đó.
AGENT_TELEGRAM_CHAT_ID=
AGENT_CODER_ENABLED=true
AGENT_BASE_BRANCH=erp-v2
AGENT_MAIN_BRANCH=main

# ── Khóa của CHỦ MÁY ──
# Claude Code đăng nhập bằng gói của chủ máy: `claude setup-token` trên máy rồi dán vào đây.
CLAUDE_CODE_OAUTH_TOKEN=
# PAT GitHub của chủ máy: quyền repo (đẩy nhánh bot/* + gộp vào erp-v2). Không dùng PAT của đại ca.
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_REPO=giabaohb99/procurement-tool

# ── CHỈ máy được đại ca bật cờ deploy («cho máy X được deploy») ──
AGENT_DEPLOY_ENABLED=false
AGENT_VPS_HOST=
AGENT_VPS_PORT=22
AGENT_VPS_USER=
AGENT_VPS_SSH_KEY_FILE=
