# .env.agent — cấu hình DỊCH VỤ AI (ai-CR-119). Chép thành .env.agent, điền giá trị, KHÔNG commit.
AGENT_MODE=service

# MySQL dùng chung với ERP, DATABASE RIÊNG + tài khoản riêng (tạo bằng scripts/agent_split/create_agent_db.sql)
DB_HOST=procurement-mysql
DB_PORT=3306
DB_NAME=agent_hub
DB_USER=agent_hub
DB_PASSWORD=

# PHẢI TRÙNG với ERP: khóa AI, token Google, khóa MCP trong DB được mã hóa bằng khóa suy từ JWT_SECRET.
JWT_SECRET=

# Hai đầu nói chuyện: dịch vụ AI → ERP (cổng B) và khóa ký chung (trùng AGENT_SERVICE_SECRET trong .env.dev của ERP)
# Dùng TÊN CONTAINER, không dùng bí danh `api`: trên mạng dego-db bí danh đó trỏ tới hai máy chủ (dev + stack khác).
AGENT_GATEWAY_URL=http://procurement-tool-dev-api-1:8000
AGENT_SERVICE_SECRET=
# Địa chỉ web ERP để bot in link mở phiếu
AGENT_ERP_URL=https://deverp.degoholding.vn

# Bot — chép từ .env.dev cũ
AGENT_HUB_ENABLED=true
AGENT_TELEGRAM_BOT_TOKEN=
AGENT_TELEGRAM_BOT_USERNAME=
AGENT_TELEGRAM_CHAT_ID=
AGENT_ZALO_BOT_TOKEN=
AGENT_LINK_ENABLED=true
AGENT_BOT_NAME=Lạc Lạc
AGENT_GEMINI_API_KEY=
AGENT_CODER_ENABLED=true
AGENT_DEPLOY_ENABLED=false
AGENT_DEFAULT_RUNNER=may-dai-ca
AGENT_OPS_ENABLED=true
AGENT_HEAL_ENABLED=true
AGENT_GOOGLE_CLIENT_ID=
AGENT_GOOGLE_CLIENT_SECRET=
AGENT_FILES_DIR=/agent-files

# Trợ lý AI trên web chạy trong dịch vụ này (S-3)
AI_ENABLED=true
AI_DEFAULT_PROVIDER=gemini
AI_GEMINI_MODEL=gemini-flash-latest
AI_RAG_ENABLED=false
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Kho tệp (R2) nếu bot xuất tệp — chép từ ERP
STORAGE_PREFIX=agent
