# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=procurement
DB_USER=app
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# JWT & bảo mật
JWT_SECRET=change_me_please
ACCESS_EXPIRE_MIN=60
REFRESH_EXPIRE_DAYS=7
# Liệt kê ĐỦ origin của MỌI app gọi API: Thu mua (8080) + Hướng dẫn sử dụng (8082).
# Lên domain thật phải đổi thành danh sách domain, vd:
#   CORS_ORIGINS=https://thumua.degoholding.vn,https://help.degoholding.vn
CORS_ORIGINS=http://localhost:8080,http://localhost:8082,http://localhost:5173
LOGIN_RATE_LIMIT=10/minute

# Admin seed (tài khoản quản trị mặc định)
ADMIN_CODE=degoadmin
ADMIN_PASSWORD=dego2026

# Seed tài khoản quản trị Trung tâm Hướng dẫn sử dụng (đăng nhập: helpadmin / HDSD0001)
HELP_ADMIN_PASSWORD=helpadmin

# Frontend (Vite đọc lúc dev)
# Để TRỐNG khi chạy Docker: cả 2 app gọi /api tương đối qua proxy Vite -> không dính CORS.
# Đặt giá trị tuyệt đối (hoặc build prod) thì phải khai báo origin tương ứng ở CORS_ORIGINS.
VITE_API_URL=http://localhost:8000
VITE_DEVELOPER_MODE=dev
# URL app Hướng dẫn sử dụng — menu trong app Thu mua trỏ sang đây (mở tab mới).
# Đổi sang subdomain khi lên prod, vd: VITE_HELP_URL=https://help.degoholding.vn
# Lưu ý: user có quyền help_article/write được bàn giao phiên qua hash (#t=&r=) trên URL này,
# nên nó phải là domain của app Hướng dẫn sử dụng, KHÔNG đặt qua redirect trung gian.
VITE_HELP_URL=http://localhost:8082
# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (lưu file) và Email (SMTP) KHÔNG còn đặt ở đây.
# Cấu hình trong app: Hệ thống → Cấu hình hệ thống (lưu DB, secret mã hóa bằng JWT_SECRET).
# Nếu muốn khởi tạo (bootstrap) lần đầu bằng env, có thể thêm lại các biến
# R2_ENDPOINT/R2_BUCKET/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_PUBLIC_URL,
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD/SMTP_FROM, EMAIL_ENABLED —
# nhưng giá trị trong DB sẽ được ưu tiên (env chỉ là fallback).
# ─────────────────────────────────────────────────────────────
# Kho R2 của APP CŨ (đặt xe / duyệt dấu) — CHỈ ĐỌC, và CHỈ đặt ở đây.
# 1488 tệp đính kèm nạp về 16/09/2026 mới có mô tả dưới DB, byte vẫn nằm nguyên
# bucket bên đó; thiếu bốn dòng này thì người dùng bấm xem tệp sẽ nhận câu
# "chưa cấu hình để đọc kho app cũ" (503), không phải lỗi lạ.
# Cùng tài khoản Cloudflare với kho ERP, chỉ khác bucket → token phải là
# "Object Read only" giới hạn đúng bucket đó. KHÔNG cấp quyền ghi: app cũ đang
# chạy thật trên kho ấy. CỐ Ý không đi qua Cấu hình hệ thống (đây là khóa bí mật).
# LEGACY_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LEGACY_R2_BUCKET=degoholding-app-cdn
# LEGACY_R2_ACCESS_KEY_ID=
# LEGACY_R2_SECRET_ACCESS_KEY=
# ─────────────────────────────────────────────────────────────
# AGENT HUB — bộ máy tự động hóa bằng AI (doc/agent-hub/)
# Bậc 1: nhận ticket qua Telegram, Gemini gom + tóm tắt + đề xuất cách sửa,
# in ra Telegram và ghi vào sổ. KHÔNG sửa một dòng mã nào.
# Mọi cờ mặc định TẮT — chưa bật thì không lời gọi nào đi ra ngoài.

AGENT_HUB_ENABLED=false
# Bot token lấy từ @BotFather. Đây là KHÓA BÍ MẬT: đừng commit, đừng dán vào chat.
AGENT_TELEGRAM_BOT_TOKEN=
# CHỈ chat_id này được ra lệnh. Nhắn cho bot một câu rồi mở
#   https://api.telegram.org/bot<TOKEN>/getUpdates   để lấy số này.
# Số âm nghĩa là nhóm — đúng chuẩn, cứ dán nguyên cả dấu trừ.
AGENT_TELEGRAM_CHAT_ID=
# Key Gemini RIÊNG của bot (QĐ-AI-7) — cố ý KHÔNG dùng chung GEMINI_API_KEY của
# Trợ lý AI: bot chạy nền gọi liên tục, đốt hết hạn mức thì trợ lý đang phục vụ
# người thật chết theo mà không ai biết vì sao. Lấy ở https://aistudio.google.com/apikey
AGENT_GEMINI_API_KEY=
AGENT_MANAGER_MODEL=gemini-flash-latest
# Trần tự vệ — sờ vào trước khi nghi bot chạy loạn.
AGENT_DAILY_TASK_CAP=5
# Lệnh /hoi trên Telegram chạy Trợ lý AI sẵn có của ERP. Trợ lý lọc dữ liệu theo
# NGƯỜI ĐĂNG NHẬP, mà Telegram thì không đăng nhập — nên khai email một tài khoản
# ERP ở đây, bot sẽ hỏi dưới đúng quyền của người đó.
# Để TRỐNG = tắt hẳn /hoi. Đừng khai tài khoản quản trị: ai nhắn được cho bot sẽ
# đọc được đúng những gì tài khoản này đọc được.
AGENT_ASSISTANT_USER=
# ─────────────────────────────────────────────────────────────
