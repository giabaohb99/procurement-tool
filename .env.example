# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=procurement
DB_USER=app
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# JWT & bảo mật
JWT_SECRET=change_me_please
ACCESS_EXPIRE_MIN=60
REFRESH_EXPIRE_DAYS=7
# Liệt kê ĐỦ origin của MỌI app gọi API: Thu mua (8080) + Hướng dẫn sử dụng (8082).
# Lên domain thật phải đổi thành danh sách domain, vd:
#   CORS_ORIGINS=https://thumua.degoholding.vn,https://hdsd.degoholding.vn
CORS_ORIGINS=http://localhost:8080,http://localhost:8082,http://localhost:5173
LOGIN_RATE_LIMIT=10/minute

# Admin seed (tài khoản quản trị mặc định)
ADMIN_CODE=degoadmin
ADMIN_PASSWORD=dego2026

# Seed tài khoản quản trị Trung tâm Hướng dẫn sử dụng (đăng nhập: helpadmin / HDSD0001)
HELP_ADMIN_PASSWORD=helpadmin

# Frontend (Vite đọc lúc dev)
# Để TRỐNG khi chạy Docker: cả 2 app gọi /api tương đối qua proxy Vite -> không dính CORS.
# Đặt giá trị tuyệt đối (hoặc build prod) thì phải khai báo origin tương ứng ở CORS_ORIGINS.
VITE_API_URL=http://localhost:8000
VITE_DEVELOPER_MODE=dev
# URL app Hướng dẫn sử dụng — menu trong app Thu mua trỏ sang đây (mở tab mới).
# Đổi sang subdomain khi lên prod, vd: VITE_HELP_URL=https://hdsd.degoholding.vn
# Lưu ý: user có quyền help_article/write được bàn giao phiên qua hash (#t=&r=) trên URL này,
# nên nó phải là domain của app Hướng dẫn sử dụng, KHÔNG đặt qua redirect trung gian.
VITE_HELP_URL=http://localhost:8082
# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (lưu file) và Email (SMTP) KHÔNG còn đặt ở đây.
# Cấu hình trong app: Hệ thống → Cấu hình hệ thống (lưu DB, secret mã hóa bằng JWT_SECRET).
# Nếu muốn khởi tạo (bootstrap) lần đầu bằng env, có thể thêm lại các biến
# R2_ENDPOINT/R2_BUCKET/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_PUBLIC_URL,
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD/SMTP_FROM, EMAIL_ENABLED —
# nhưng giá trị trong DB sẽ được ưu tiên (env chỉ là fallback).
# ─────────────────────────────────────────────────────────────
