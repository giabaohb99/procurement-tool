# Base URL của API. Để RỖNG = gọi tương đối, đi qua proxy Vite (khuyên dùng cho dev).
# Production build thì đặt domain thật, vd https://erp.degoholding.vn
VITE_API_URL=

# Đích proxy của Vite dev server cho đường dẫn /api
# - Chạy ngoài Docker: http://localhost:8000
# - Chạy trong docker compose: http://api:8000
VITE_API_PROXY_TARGET=http://localhost:8000

VITE_APP_NAME=DEGO ERP

# App Trung tâm Hướng dẫn sử dụng (thư mục help-center/, mặc định cổng 8082).
VITE_HELP_URL=http://localhost:8082
